# Databricks SQL Warehouse (PAT auth) -- used by src/data/databricks_client.py
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Databricks Jobs + Volumes (same PAT token above) -- used by databricks_jobs.py
# for POST /pipeline/upload, /pipeline/trigger, /pipeline/upload-and-trigger.
# DATABRICKS_HOST is optional -- if omitted, it's derived as
# https://<DATABRICKS_SERVER_HOSTNAME> automatically.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_JOB_ID=your-job-id
DATABRICKS_VOLUME_INCOMING_PATH=/Volumes/catalog/schema/volume/incoming

# Azure OpenAI -- used by llm_client.py for POST /forecast/explain
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-gpt-deployment-name
AZURE_OPENAI_API_VERSION=2024-06-01

# CORS -- Allowed frontend origins (comma-separated)
# Local: http://localhost:5173,http://localhost:3000
# Production: Add your Azure Container Apps frontend URL here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
